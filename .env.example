# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- SimPRO API ---
SIMPRO_BASE_URL=https://redmen.simprosuite.com
SIMPRO_TOKEN=

# --- NextAuth (Google sign-in) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
# Full site URL NextAuth uses for redirects locally
NEXTAUTH_URL=http://localhost:3000
# Full site URL NextAuth uses for redirects in production
NEXTAUTH_URL_PRODUCTION=

# --- Google Workspace group-membership check (app/lib/auth.ts) ---
# Service account authorized for domain-wide delegation with scope
# https://www.googleapis.com/auth/admin.directory.group.member.readonly
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Workspace admin the service account impersonates to query group membership
GOOGLE_ADMIN_EMAIL=

# --- Google Cloud Storage (optional cache backend) ---
GCS_BUCKET=
